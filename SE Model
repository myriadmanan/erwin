CREATE  TRIGGER  tD_CUST_CNTCT AFTER DELETE ON CUST_CNTCT for each row
-- erwin Builtin Trigger
-- DELETE trigger on CUST_CNTCT 
DECLARE NUMROWS INTEGER;
BEGIN
    /* erwin Builtin Trigger */
    /* CUST_CNTCT  CUST_CNTCT_ROLE on parent delete restrict */
    /* ERWIN_RELATION:CHECKSUM="00032e9c", PARENT_OWNER="", PARENT_TABLE="CUST_CNTCT"
    CHILD_OWNER="", CHILD_TABLE="CUST_CNTCT_ROLE"
    P2C_VERB_PHRASE="", C2P_VERB_PHRASE="", 
    FK_CONSTRAINT="R_32", FK_COLUMNS="CUSTOMER_CONTACT_IDENTIFIER" */
    SELECT count(*) INTO NUMROWS
      FROM CUST_CNTCT_ROLE
      WHERE
        /*  %JoinFKPK(CUST_CNTCT_ROLE,:%Old," = "," AND") */
        CUST_CNTCT_ROLE.CUSTOMER_CONTACT_IDENTIFIER = :old.CUSTOMER_CONTACT_IDENTIFIER;
    IF (NUMROWS > 0)
    THEN
